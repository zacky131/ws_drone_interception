<?xml version="1.0"?>
<sdf version="1.9">
  <model name="virtual_target_marker">
    <static>true</static>
    <link name="visual_only">
      <visual name="target_sphere">
        <geometry><sphere><radius>0.32</radius></sphere></geometry>
        <material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse></material>
      </visual>
      <visual name="capture_sphere">
        <geometry><sphere><radius>1.0</radius></sphere></geometry>
        <transparency>0.78</transparency>
        <material><ambient>1 0.75 0.1 0.22</ambient><diffuse>1 0.75 0.1 0.22</diffuse></material>
      </visual>
      <visual name="vertical_reference">
        <pose>0 0 -2.5 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>5.0</length></cylinder></geometry>
        <material><ambient>1 0.6 0.05 0.7</ambient><diffuse>1 0.6 0.05 0.7</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
