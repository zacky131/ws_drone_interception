Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: ENU ground grid
      Enabled: true
      Cell Size: 5
      Plane: XY
    - Class: rviz_default_plugins/MarkerArray
      Name: Mirror markers
      Enabled: true
      Topic:
        Value: /ras_hw_mirror/visualization/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: Interceptor path
      Enabled: true
      Topic:
        Value: /ras_hw_mirror/interceptor/path
      Line Style: Lines
      Line Width: 0.08
      Color: 0; 115; 190
    - Class: rviz_default_plugins/Path
      Name: Target truth path
      Enabled: true
      Topic:
        Value: /ras_hw_mirror/target/truth_path
      Line Style: Billboards
      Line Width: 0.06
      Color: 30; 30; 30
    - Class: rviz_default_plugins/Path
      Name: Target prediction horizon
      Enabled: true
      Topic:
        Value: /ras_hw_mirror/target/prediction_path
      Line Style: Billboards
      Line Width: 0.10
      Color: 0; 158; 115
    - Class: rviz_default_plugins/TF
      Name: Minimal TF
      Enabled: true
      Frame Timeout: 2
  Global Options:
    Background Color: 38; 43; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down ENU
      Scale: 1.2
      X: 0
      Y: 0
Window Geometry:
  Height: 850
  Width: 1100
